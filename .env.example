# Copy to .env and fill in the password. Never commit the real .env file.

# --- PostgreSQL (serving layer for aggregated metrics) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rideshare
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRIP_EVENTS=rideshare.trip-events
KAFKA_TOPIC_DRIVER_LOCATIONS=rideshare.driver-locations

# --- AWS ---
AWS_REGION=us-east-1
S3_BUCKET=your-rideshare-data-lake
S3_RAW_PREFIX=raw/trip-events
S3_CHECKPOINT_PREFIX=checkpoints/trip-events

# --- API ---
API_PORT=8000
