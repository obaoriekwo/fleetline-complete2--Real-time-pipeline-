# Build context is the project root (see docker-compose.yml's api service:
# `context: .`, `dockerfile: api/Dockerfile`). The API container only needs
# api/, db/, and requirements.txt - everything else here just slows down
# the build and bloats the image for no reason.

.git/
.gitignore
README.md
.env
.env.example

# Not needed inside the API container
frontend/
producer/
spark/
aws/
tests/

# Python/OS cruft
__pycache__/
*.pyc
.venv/
venv/
.DS_Store
